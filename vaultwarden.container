[Container]
Image=docker.io/vaultwarden/server:1.37.4@sha256:efb3cde962015fcc036b2ea625242248611943b27212ebf4392841fb30fad055
ContainerName=vaultwarden

Network=vaultwarden.network

Secret=lab_smtp_username,target=smtp_username,uid=1000,gid=1000,mode=0400
Secret=lab_smtp_password,target=smtp_password,uid=1000,gid=1000,mode=0400

Environment=DOMAIN=https://vault.mwdle.com
Environment=IP_HEADER=X-Forwarded-For
# TODO
# Environment=IP_HEADER_TRUSTED_PROXIES=
Environment=SIGNUPS_ALLOWED=false
Environment=SMTP_FROM_FILE=/run/secrets/smtp_username
Environment=SMTP_HOST=heracles.mxrouting.net
Environment=SMTP_PASSWORD_FILE=/run/secrets/smtp_password
Environment=SMTP_PORT=465
Environment=SMTP_SECURITY=force_tls
Environment=SMTP_USERNAME_FILE=/run/secrets/smtp_username
Environment=TZ=America/Denver

Volume=%h/containers/vaultwarden:/data:U,Z

ReadOnly=true
ReadOnlyTmpfs=false

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=["/healthcheck.sh"]
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=["/healthcheck.sh"]
HealthInterval=60s
HealthTimeout=10s
HealthOnFailure=kill
Notify=healthy

Memory=256M
PidsLimit=50

[Service]
CPUQuota=50%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/vaultwarden

[Install]
WantedBy=default.target
